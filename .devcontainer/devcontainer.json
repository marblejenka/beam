{
	"name": "apache beam",
	"build": {
		"dockerfile": "./Dockerfile",
		"args": {
			"HOST_USER_ID": "${localEnv:VSCODE_USER_ID}",
			"HOST_USER_GID": "${localEnv:VSCODE_GROUP_ID}"
		}
	},
	"onCreateCommand": "docker build -t beam-build ${containerWorkspaceFolder}/dev-support/docker",
	"remoteUser": "${localEnv:VSCODE_USER_ID}"
}